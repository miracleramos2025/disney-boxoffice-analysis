filter(Studio_Group != "Disney") |>
mutate(
Period = case_when(
Studio_Group == "Pixar" & Year >= 2006 ~ "After",
Studio_Group == "Pixar" & Year < 2006 ~ "Before",
Studio_Group == "Marvel" & Year >= 2009 ~ "After",
Studio_Group == "Marvel" & Year < 2009 ~ "Before",
Studio_Group == "Lucasfilm" & Year >= 2012 ~ "After",
Studio_Group == "Lucasfilm" & Year < 2012 ~ "Before"
)
) |>
group_by(Studio_Group, Period) |>
summarize(
avg_revenue_m = mean(Inflation_Adjusted_Gross, na.rm = TRUE) / 1e6,
movie_count = n(),
.groups = "drop"
) |>
arrange(Studio_Group, Period)
disney_data |>
mutate(
Studio_Group = if_else(Studio_Group == "Disney / Other", "Disney", Studio_Group)
) |>
filter(Year >= 2006) |>
group_by(Studio_Group) |>
summarize(
movie_count = n(),
total_revenue_b = sum(Inflation_Adjusted_Gross, na.rm = TRUE) / 1e9,
.groups = "drop"
) |>
mutate(
revenue_share = total_revenue_b / sum(total_revenue_b) * 100,
film_share = movie_count / sum(movie_count) * 100
)
share_data <- disney_data |>
mutate(
Studio_Group = if_else(Studio_Group == "Disney / Other", "Disney", Studio_Group)
) |>
filter(Year >= 2006) |>
group_by(Studio_Group) |>
summarize(
movie_count = n(),
total_revenue_b = sum(Inflation_Adjusted_Gross, na.rm = TRUE) / 1e9,
.groups = "drop"
) |>
mutate(
revenue_share = total_revenue_b / sum(total_revenue_b) * 100,
film_share = movie_count / sum(movie_count) * 100
)
dumbbell_plot <- ggplot(share_data) +
# connecting line
geom_segment(
aes(
x = film_share,
xend = revenue_share,
y = reorder(Studio_Group, revenue_share),
yend = reorder(Studio_Group, revenue_share)
),
color = "#0F2656",
alpha = 0.3,
linewidth = 2.5
) +
# film share dot
geom_point(
aes(x = film_share, y = reorder(Studio_Group, revenue_share)),
color = "#62B7FD",
size = 8
) +
# revenue share dot
geom_point(
aes(x = revenue_share, y = reorder(Studio_Group, revenue_share)),
color = "#0F2656",
size = 8
) +
# film share labels
geom_text(
aes(x = film_share, y = reorder(Studio_Group, revenue_share),
label = paste0(round(film_share), "%")),
color = "white",
size = 3.5,
fontface = "bold"
) +
# revenue share labels
geom_text(
aes(x = revenue_share, y = reorder(Studio_Group, revenue_share),
label = paste0(round(revenue_share), "%")),
color = "white",
size = 3.5,
fontface = "bold"
) +
# legend annotation
annotate("point", x = 52, y = 0.6, color = "#62B7FD", size = 6) +
annotate("text", x = 53.5, y = 0.6, label = "Share of Films",
hjust = 0, color = "#0F2656", size = 4.5, fontface = "bold") +
annotate("point", x = 68, y = 0.6, color = "#0F2656", size = 6) +
annotate("text", x = 69.5, y = 0.6, label = "Share of Revenue",
hjust = 0, color = "#0F2656", size = 4.5, fontface = "bold") +
scale_x_continuous(
labels = function(x) paste0(x, "%"),
limits = c(0, 95),
expand = expansion(mult = c(0.02, 0.05))
) +
labs(
title = "More Films, Less Return",
subtitle = "Acquired studios produce 14% of Disney's films but generate 38% of box office revenue",
x = "Share (%)",
y = NULL
) +
theme_minimal() +
theme(
plot.background = element_rect(fill = "#F2F3F4", color = NA),
panel.background = element_rect(fill = "#F2F3F4", color = NA),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.major.x = element_line(color = alpha("#0F2656", 0.15)),
plot.title = element_text(size = 29, face = "bold", hjust = 0, color = "#0F2656"),
plot.subtitle = element_text(size = 16, face = "bold", hjust = 0, color = "#0F2656"),
axis.title.x = element_text(size = 20, face = "bold", color = "#0F2656", margin = margin(t = 15)),
axis.text = element_text(size = 18, face = "bold", color = "#0F2656"),
plot.margin = margin(20, 20, 20, 20)
)
ggsave(
"portfolio plots/film_vs_revenue_share.png",
plot = dumbbell_plot,
width = 12,
height = 7,
dpi = 300,
bg = "#F2F3F4"
)
share_long <- share_data |>
select(Studio_Group, film_share, revenue_share) |>
pivot_longer(
cols = c(film_share, revenue_share),
names_to = "Metric",
values_to = "Share"
) |>
mutate(
Metric = if_else(Metric == "film_share", "Share of Films", "Share of Revenue")
)
grouped_plot <- ggplot(
share_long,
aes(
x = reorder(Studio_Group, -Share),
y = Share,
fill = Metric
)
) +
geom_col(position = "dodge", width = 0.6) +
geom_text(
aes(label = paste0(round(Share), "%")),
position = position_dodge(width = 0.6),
vjust = -0.5,
size = 5,
fontface = "bold",
color = "#0F2656"
) +
scale_fill_manual(values = c(
"Share of Films"   = "#62B7FD",
"Share of Revenue" = "#0F2656"
)) +
scale_y_continuous(
labels = function(x) paste0(x, "%"),
expand = expansion(mult = c(0, 0.12))
) +
labs(
title = "More Films, Less Return",
subtitle = "Acquired studios produce 14% of Disney's films but generate 38% of box office revenue",
x = NULL,
y = "Share (%)",
fill = NULL
) +
theme_minimal() +
theme(
plot.background = element_rect(fill = "#F2F3F4", color = NA),
panel.background = element_rect(fill = "#F2F3F4", color = NA),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
panel.grid.major.y = element_line(color = alpha("#0F2656", 0.15)),
plot.title = element_text(size = 29, face = "bold", hjust = 0, color = "#0F2656"),
plot.subtitle = element_text(size = 16, face = "bold", hjust = 0, color = "#0F2656"),
axis.title.y = element_text(size = 20, face = "bold", color = "#0F2656", margin = margin(r = 15)),
axis.text = element_text(size = 18, face = "bold", color = "#0F2656"),
legend.text = element_text(size = 14, face = "bold", color = "#0F2656"),
legend.position = "top",
legend.justification = "left",
plot.margin = margin(20, 20, 20, 20)
)
ggsave(
"portfolio plots/film_vs_revenue_share.png",
plot = grouped_plot,
width = 12,
height = 7,
dpi = 300,
bg = "#F2F3F4"
)
